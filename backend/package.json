{
  "name": "jollivo-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,json --exec \"tsx --env-file-if-exists=.env src/index.ts\"",
    "dev:backend": "npm run dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test mocha",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:status": "node --env-file-if-exists=.env src/db/migrate.ts status",
    "migrate:undo": "node --env-file-if-exists=.env src/db/migrate.ts down",
    "migrations": "source .env && db-migrate",
    "migrate:create": "npm run migrations -- create",
    "postmigrate:create": "node scripts/esm-migrations.js",
    "migrate:up": "db-migrate up  --config database.json",
    "migrate:down": "db-migrate down  --config database.json",
    "migrate-test:up": "db-migrate up --config database.json -e test",
    "migrate-test:down": "db-migrate down -c 100 --config database.json -e test",
    "migrate:reset": "db-migrate reset --config database.json",
    "migrate-test:reset": "db-migrate reset --config database.json -e test",
    "seed:create": "db-migrate create:seed --config database.json",
    "postseed:create": "node scripts/esm-migrations.js",
    "seed:up": "db-migrate up:seed --config database.json",
    "seed:down": "db-migrate down:seed --config database.json",
    "seed:reset": "db-migrate reset:seed --config database.json",
    "seed:reset:test": "db-migrate reset:seed --config database.json -e test"
  },
  "dependencies": {
    "@clerk/express": "^2",
    "cors": "^2.8.5",
    "db-migrate": "^1.9.0",
    "db-migrate-pg": "^1.7.1",
    "express": "^5",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "pg": "^8",
    "pg-promise": "^12.8.0",
    "redis": "^6.3.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-loki": "^6.1.7",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.17",
    "@types/express": "^5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/swagger-ui-express": "^4.1.8",
    "chai": "^4.5.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
